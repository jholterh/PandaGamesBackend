<% if entries.any? %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <% entries.each_with_index do |entry, i| %>
      <div class="flex items-center justify-between px-4 py-3 <%= i.positive? ? 'border-t border-gray-100' : '' %>">
        <div class="flex items-center gap-3">
          <span class="w-8 text-center font-bold text-gray-400"><%= i + 1 %></span>
          <span class="font-medium"><%= entry.user.username %></span>
        </div>
        <span class="font-mono font-bold text-lg"><%= entry.score %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-400 text-center py-12">No scores yet. Be the first!</p>
<% end %>
