<% wrapper_tag = linkable? ? :a : :div %>
<%= content_tag(wrapper_tag, class: "bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow block", href: (linkable? ? mini_app.route_prefix : nil)) do %>
  <% if mini_app.thumbnail_url.present? %>
    <img src="<%= mini_app.thumbnail_url %>" alt="<%= mini_app.name %>" class="w-full h-40 object-cover">
  <% else %>
    <div class="w-full h-40 bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
      <span class="text-4xl">🎮</span>
    </div>
  <% end %>
  <div class="p-4">
    <h2 class="font-bold text-lg"><%= mini_app.name %></h2>
    <p class="text-gray-500 text-sm mt-1 line-clamp-2"><%= mini_app.description %></p>
    <div class="flex items-center justify-between mt-3 text-xs text-gray-400">
      <span>by <%= mini_app.author %></span>
      <span><%= mini_app.play_count %> plays</span>
    </div>
  </div>
<% end %>
