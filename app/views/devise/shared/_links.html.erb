<div class="mt-6 text-center text-sm space-y-2">
  <%- if controller_name != "sessions" %>
    <p>
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <p>
      Don't have an account?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p>
      <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </p>
  <% end %>
</div>
