<nav class="bg-white shadow-sm border-b border-gray-200">
  <div class="container mx-auto px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= link_to "Panda Gang", root_path, class: "text-xl font-bold text-gray-900" %>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <% if user_signed_in? %>
        <span class="text-gray-600">Hey, <%= current_user.username %>!</span>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-red-600 hover:text-red-800" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "text-blue-600 hover:text-blue-800" %>
        <%= link_to "Sign up", new_user_registration_path, class: "bg-blue-600 text-white px-3 py-1.5 rounded-md hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>
</nav>
