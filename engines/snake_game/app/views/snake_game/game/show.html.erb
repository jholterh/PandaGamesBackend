<div class="min-h-screen bg-gray-900 flex flex-col items-center justify-center py-8"
     data-controller="snake"
     data-snake-score-url-value="<%= snake_game.score_path %>">

  <h1 class="text-3xl font-bold text-green-400 mb-2">Snake Game</h1>

  <div class="flex items-center gap-6 mb-4">
    <div class="text-white text-lg">
      Score: <span class="font-mono font-bold text-green-300" data-snake-target="score">0</span>
    </div>
    <div class="text-white text-lg">
      High Score: <span class="font-mono font-bold text-yellow-300" data-snake-target="highScore">0</span>
    </div>
  </div>

  <div class="relative">
    <canvas data-snake-target="canvas"
            class="border-2 border-green-500 rounded-lg bg-gray-800"
            width="400"
            height="400">
    </canvas>

    <!-- Start Screen Overlay -->
    <div data-snake-target="startScreen"
         class="absolute inset-0 flex flex-col items-center justify-center bg-gray-800 bg-opacity-90 rounded-lg">
      <p class="text-green-400 text-xl font-bold mb-4">Press any arrow key to start</p>
      <p class="text-gray-400 text-sm">Use arrow keys to control the snake</p>
    </div>

    <!-- Game Over Overlay -->
    <div data-snake-target="gameOver"
         class="absolute inset-0 flex flex-col items-center justify-center bg-gray-800 bg-opacity-90 rounded-lg hidden">
      <p class="text-red-400 text-2xl font-bold mb-2">Game Over!</p>
      <p class="text-white text-lg mb-1">
        Score: <span class="font-mono font-bold text-green-300" data-snake-target="finalScore">0</span>
      </p>
      <p class="text-gray-400 text-sm mb-4" data-snake-target="scoreStatus"></p>
      <button data-action="click->snake#restart"
              class="px-6 py-2 bg-green-600 hover:bg-green-500 text-white font-bold rounded-lg transition-colors cursor-pointer">
        Play Again
      </button>
    </div>
  </div>

  <p class="text-gray-500 text-sm mt-4">Use arrow keys to move</p>

  <div class="mt-4">
    <%= link_to "Back to Dashboard", main_app.root_path,
        class: "text-green-400 hover:text-green-300 underline text-sm" %>
  </div>
</div>

<script type="module">
  import { Controller, Application } from "@hotwired/stimulus"

  const application = Application.start()

  class SnakeController extends Controller {
    static targets = ["canvas", "score", "highScore", "gameOver", "finalScore", "scoreStatus", "startScreen"]
    static values = { scoreUrl: String }

    connect() {
      this.gridSize = 20
      this.tileCount = 20
      this.canvas = this.canvasTarget
      this.ctx = this.canvas.getContext("2d")
      this.highScoreVal = 0
      this.gameStarted = false
      this.gameRunning = false

      this.boundKeyHandler = this.handleKeydown.bind(this)
      document.addEventListener("keydown", this.boundKeyHandler)

      this.drawInitialBoard()
    }

    disconnect() {
      document.removeEventListener("keydown", this.boundKeyHandler)
      if (this.gameLoop) cancelAnimationFrame(this.gameLoop)
      if (this.timeout) clearTimeout(this.timeout)
    }

    drawInitialBoard() {
      this.ctx.fillStyle = "#1f2937"
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height)
    }

    initGame() {
      this.snake = [{ x: 10, y: 10 }]
      this.direction = { x: 0, y: -1 }
      this.nextDirection = { x: 0, y: -1 }
      this.food = this.spawnFood()
      this.currentScore = 0
      this.foodEaten = 0
      this.speed = 150
      this.gameRunning = true

      this.scoreTarget.textContent = "0"
      this.gameOverTarget.classList.add("hidden")
    }

    handleKeydown(e) {
      if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(e.key)) return
      e.preventDefault()

      if (!this.gameStarted || !this.gameRunning) {
        this.gameStarted = true
        this.startScreenTarget.classList.add("hidden")
        this.initGame()

        // Set initial direction based on key press
        this.setDirection(e.key)
        this.nextDirection = { ...this.direction }
        this.tick()
        return
      }

      this.setDirection(e.key)
    }

    setDirection(key) {
      const dirs = {
        ArrowUp:    { x:  0, y: -1 },
        ArrowDown:  { x:  0, y:  1 },
        ArrowLeft:  { x: -1, y:  0 },
        ArrowRight: { x:  1, y:  0 }
      }

      const newDir = dirs[key]
      if (!newDir) return

      // Prevent reversing into yourself
      if (this.direction.x + newDir.x === 0 && this.direction.y + newDir.y === 0) return

      this.nextDirection = newDir
    }

    tick() {
      if (!this.gameRunning) return

      this.direction = { ...this.nextDirection }
      const head = {
        x: this.snake[0].x + this.direction.x,
        y: this.snake[0].y + this.direction.y
      }

      // Wall collision
      if (head.x < 0 || head.x >= this.tileCount || head.y < 0 || head.y >= this.tileCount) {
        this.endGame()
        return
      }

      // Self collision
      if (this.snake.some(seg => seg.x === head.x && seg.y === head.y)) {
        this.endGame()
        return
      }

      this.snake.unshift(head)

      // Food collision
      if (head.x === this.food.x && head.y === this.food.y) {
        this.foodEaten++
        this.currentScore = this.foodEaten * 10
        this.scoreTarget.textContent = this.currentScore
        this.food = this.spawnFood()
        // Increase speed every 3 food eaten, down to minimum of 60ms
        if (this.foodEaten % 3 === 0 && this.speed > 60) {
          this.speed = Math.max(60, this.speed - 15)
        }
      } else {
        this.snake.pop()
      }

      this.draw()
      this.timeout = setTimeout(() => this.tick(), this.speed)
    }

    spawnFood() {
      let pos
      do {
        pos = {
          x: Math.floor(Math.random() * this.tileCount),
          y: Math.floor(Math.random() * this.tileCount)
        }
      } while (this.snake && this.snake.some(seg => seg.x === pos.x && seg.y === pos.y))
      return pos
    }

    draw() {
      const gs = this.gridSize
      this.ctx.fillStyle = "#1f2937"
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height)

      // Draw grid lines (subtle)
      this.ctx.strokeStyle = "#374151"
      this.ctx.lineWidth = 0.5
      for (let i = 0; i < this.tileCount; i++) {
        this.ctx.beginPath()
        this.ctx.moveTo(i * gs, 0)
        this.ctx.lineTo(i * gs, this.canvas.height)
        this.ctx.stroke()
        this.ctx.beginPath()
        this.ctx.moveTo(0, i * gs)
        this.ctx.lineTo(this.canvas.width, i * gs)
        this.ctx.stroke()
      }

      // Draw food
      this.ctx.fillStyle = "#ef4444"
      this.ctx.beginPath()
      this.ctx.arc(
        this.food.x * gs + gs / 2,
        this.food.y * gs + gs / 2,
        gs / 2 - 2, 0, Math.PI * 2
      )
      this.ctx.fill()

      // Draw snake
      this.snake.forEach((seg, i) => {
        this.ctx.fillStyle = i === 0 ? "#22c55e" : "#4ade80"
        this.ctx.fillRect(seg.x * gs + 1, seg.y * gs + 1, gs - 2, gs - 2)
        this.ctx.strokeStyle = "#166534"
        this.ctx.lineWidth = 1
        this.ctx.strokeRect(seg.x * gs + 1, seg.y * gs + 1, gs - 2, gs - 2)
      })
    }

    async endGame() {
      this.gameRunning = false
      if (this.timeout) clearTimeout(this.timeout)

      if (this.currentScore > this.highScoreVal) {
        this.highScoreVal = this.currentScore
        this.highScoreTarget.textContent = this.highScoreVal
      }

      this.finalScoreTarget.textContent = this.currentScore
      this.gameOverTarget.classList.remove("hidden")

      // Submit score if user is logged in
      if (this.currentScore > 0) {
        try {
          const csrfToken = document.querySelector("meta[name='csrf-token']")?.content
          const response = await fetch(this.scoreUrlValue, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken
            },
            body: JSON.stringify({
              score: this.currentScore,
              food_eaten: this.foodEaten
            })
          })

          if (response.ok) {
            this.scoreStatusTarget.textContent = "Score submitted!"
          } else if (response.status === 401) {
            this.scoreStatusTarget.textContent = "Sign in to save your score"
          } else {
            this.scoreStatusTarget.textContent = "Could not save score"
          }
        } catch {
          this.scoreStatusTarget.textContent = "Could not save score"
        }
      }
    }

    restart() {
      this.gameOverTarget.classList.add("hidden")
      this.initGame()
      this.tick()
    }
  }

  // Only register if not already registered
  if (!application.router.modulesByIdentifier.has("snake")) {
    application.register("snake", SnakeController)
  }
</script>
